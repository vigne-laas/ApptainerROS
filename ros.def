Bootstrap: docker
From: osrf/ros:{{version}}-desktop

%arguments
    version=noetic

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get -y upgrade

    # Outils d'init / dev nécessaires pour la surcouche archi
    apt-get install -y --no-install-recommends \
        python3-vcstool \
        python3-rosdep \
        python3-rosinstall \
        python3-rosinstall-generator \
        python3-wstool \
        python3-pip \
        git \
        openssh-client \
        ca-certificates \
        curl \
        wget \
        tmux \
        tmuxinator \
        htop \
        nano \
        less \
        sudo \
        build-essential \
        cmake

    # rosdep init (idempotent)
    if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then
        rosdep init || true
    fi

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export PS1="[noetic-base] \\w\\$ "
    export ROS_DISTRO={{version}}

%help
    Image de base immutable ROS {{version}} (depuis osrf/ros:{{version}}-desktop).
    Inclut les outils d'init : vcstool, rosdep, tmux/tmuxinator, build essentials.
    Sert d'input pour archi.def (sandbox writable).
